// GKD 订阅 · HyperOS 安装弹窗与通知 + 钉钉 / 微信小程序广告 + 美团
//
// 添加方式：GKD → 订阅 → 右下角 + → 粘贴订阅链接
// 适用：Xiaomi / HyperOS（基于 Xiaomi 17 / HyperOS 4.0.6 / GKD 1.13.2 实机抓节点）
//
// 微信小程序（v9 起）：
//   · 不用 fastQuery（小程序节点事件不稳定）
//   · action 用 clickCenter（「跳过」是 clickable=false 的 TextView）
//   · actionMaximum 显式写 1（不用 0，避免被当成“最多 0 次”）
//   · 组 9「诊断-微信窗口可达性」匹配首页「美团单车」标题，只验证 GKD 能否在该窗口触发
//
{
  id: 20261116,
  name: 'HyperOS 安装弹窗与通知',
  version: 9,
  author: 'LL8194',
  supportUri: 'https://github.com/LL8194/gkd-rules',
  categories: [],
  globalGroups: [],
  apps: [
    {
      id: 'com.android.systemui',
      name: '系统界面',
      groups: [
        {
          key: 0,
          name: '设备管理员安装提示-自动清除',
          actionCd: 2000,
          actionDelay: 250,
          rules: [
            {
              key: 0,
              matches: '[text*="由您的管理员安装"]',
              action: 'swipe',
              swipeArg: {
                start: {
                  left: 0,
                  top: 'height/2',
                },
                end: {
                  right: '-80',
                  top: 'height/2',
                },
                duration: 220,
              },
            },
          ],
        },
      ],
    },
    {
      id: 'com.miui.securitycenter',
      name: '安全中心',
      groups: [
        {
          key: 0,
          name: 'USB安装提示-自动继续安装',
          actionCd: 2000,
          actionDelay: 200,
          matchTime: 8000,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[text="继续安装"]',
              anyMatches: [
                '[text*="正在通过USB安装此应用"]',
              ],
            },
          ],
        },
      ],
    },
    {
      id: 'com.alibaba.android.rimet',
      name: '钉钉',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          fastQuery: true,
          matchTime: 20000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[text*="跳过"]',
            },
          ],
        },
        {
          key: 1,
          name: '首页横幅广告-关闭',
          fastQuery: true,
          matchTime: 15000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[vid="layout_close"]',
              anyMatches: [
                '[vid="chatting_card_view"]',
              ],
            },
          ],
        },
      ],
    },
    {
      id: 'com.zcshou.gogogo',
      name: '影梭',
      groups: [
        {
          key: 0,
          name: '更新弹窗-忽略一次',
          fastQuery: true,
          matchTime: 20000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[vid="update_ignore"]',
              anyMatches: [
                '[vid="update_title"]',
              ],
            },
          ],
        },
      ],
    },
    {
      id: 'com.tencent.mm',
      name: '微信',
      groups: [
        {
          key: 0,
          name: '小程序开屏-跳过',
          matchTime: 20000,
          actionMaximum: 1,
          actionCd: 300,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[text*="跳过"]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 1,
          name: '小程序浮层广告-关闭',
          matchTime: 30000,
          actionMaximum: 2,
          actionCd: 500,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[text="\ue003"][left>=1050][left<=1085][top>=385][top<=405][bottom<480]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 2,
          name: '广告角标-点开',
          actionCd: 1500,
          matchTime: 20000,
          actionMaximum: 0,
          resetMatch: 'activity',
          rules: [
            {
              key: 0,
              matches: '[text="广告"][width<200][left<300][visibleToUser=true]',
              anyMatches: [
                '[text*="全部行程"]',
                '[text="去骑车"]',
                '[text*="骑行"]',
              ],
            },
          ],
        },
        {
          key: 3,
          name: '广告菜单-关闭广告',
          matchTime: 8000,
          actionMaximum: 0,
          resetMatch: 'activity',
          rules: [
            {
              key: 0,
              matches: '[text*="关闭广告"]',
            },
          ],
        },
        {
          key: 9,
          name: '诊断-微信窗口可达性',
          matchTime: 20000,
          actionMaximum: 3,
          actionCd: 3000,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[text*="美团单车"]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
    {
      id: 'com.sankuai.meituan',
      name: '美团',
      groups: [
        {
          key: 0,
          name: '小程序开屏-跳过',
          matchTime: 20000,
          actionMaximum: 1,
          actionCd: 300,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              matches: '[text*="跳过"]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
  ],
}
