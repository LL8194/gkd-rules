// GKD 规则 6 · 微信小程序里的广告（开屏「跳过」+ 浮层关闭 X + 广告角标菜单）
// 实测环境：Xiaomi 17 / HyperOS 4.0.6 / GKD 1.13.2 / 2026-11-18
// 窗口：com.tencent.mm / .plugin.appbrand.ui.AppBrandUI00（小程序「美团骑行」）
//
//   开屏广告 ： 「广告 ∨」TextView [78,191][169,256]，「跳过」[273,191][373,256]，右侧「2 秒」倒计时
//   首页浮层 ： 关闭 X = 图标字体 TextView \ue003 [1062,390][1124,455]（容器 FrameLayout [1069,392][1189,489]）
//               同一页右上角「我的」笑脸图标也是 \ue003 [1056,357][1118,422] → 靠 top>=385 排除
//   底部信息流： 「广告」[81,2015][152,2054] + 「广告由微信提供」[39,2619][1183,2656]
//
// 用法：GKD → 订阅 → 本地订阅 → 应用规则 → ＋ → 粘贴下面整段对象

{
  id: 'com.tencent.mm',
  name: '微信',
  groups: [
    {
      // 小程序启动时的开屏广告，左上角「跳过」
      key: 0,
      name: '小程序开屏-跳过',
      fastQuery: true,
      matchTime: 15000,
      actionMaximum: 1,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text="跳过"][text.length<10][visibleToUser=true]',
        },
      ],
    },
    {
      // 首页右上角浮层广告的 X（实测点 [1125,440] 可关闭）
      key: 1,
      name: '小程序浮层广告-关闭',
      fastQuery: true,
      matchTime: 30000,
      actionMaximum: 2,
      actionCd: 800,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text="\ue003"][left>=1050][left<=1085][top>=385][top<=405][bottom<480]',
        },
      ],
    },
    {
      // 只有「广告 ∨」角标、没有 X 的弹窗：先点角标展开菜单
      key: 2,
      name: '广告角标-点开',
      fastQuery: true,
      actionCd: 1500,
      matchTime: 20000,
      actionMaximum: 1,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text="广告"][width<200][left<300][visibleToUser=true]',
          anyMatches: ['[text*="全部行程"]', '[text="去骑车"]', '[text*="骑行"]'],
        },
      ],
    },
    {
      key: 3,
      name: '广告菜单-关闭广告',
      fastQuery: true,
      matchTime: 8000,
      actionMaximum: 1,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text*="关闭广告"]',
        },
      ],
    },
  ],
}
