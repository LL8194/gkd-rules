// GKD 规则 6 · 微信小程序里的广告（开屏「跳过」+ 浮层关闭 X + 诊断组）
// 实测环境：Xiaomi 17 / HyperOS 4.0.6 / GKD 1.13.2 / 2026-11-18
// 窗口：com.tencent.mm / .plugin.appbrand.ui.AppBrandUI00
//
// 四条实测教训（缺一条就不动作）：
//   1) 不要开 fastQuery —— 小程序节点变化不一定推给无障碍；
//   2) action 用 'clickCenter' —— 「跳过」是 clickable=false 的 TextView，默认 clickNode 找不到可点祖先就放弃；
//   3) actionMaximum 显式写 1，不写 0（避免语义歧义）；
//   4) 组 9 是诊断组：匹配首页「美团单车」标题，有它的触发记录就说明 GKD 能在这个窗口工作。
//
// 用法：GKD → 订阅 → 本地订阅 → 应用规则 → ＋ → 粘贴下面整段对象

{
  id: 'com.tencent.mm',
  name: '微信',
  groups: [
    {
      key: 0,
      name: '小程序开屏-跳过',
      matchTime: 20000,
      actionMaximum: 1,
      actionCd: 300,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text*="跳过"]',
          action: 'clickCenter',
        },
      ],
    },
    {
      key: 1,
      name: '小程序浮层广告-关闭',
      matchTime: 30000,
      actionMaximum: 2,
      actionCd: 500,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text="\ue003"][left>=1050][left<=1085][top>=385][top<=405][bottom<480]',
          action: 'clickCenter',
        },
      ],
    },
    {
      key: 2,
      name: '广告角标-点开',
      actionCd: 1500,
      matchTime: 20000,
      actionMaximum: 0,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text="广告"][width<200][left<300][visibleToUser=true]',
          anyMatches: [
            '[text*="全部行程"]',
            '[text="去骑车"]',
            '[text*="骑行"]',
          ],
        },
      ],
    },
    {
      key: 3,
      name: '广告菜单-关闭广告',
      matchTime: 8000,
      actionMaximum: 0,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text*="关闭广告"]',
        },
      ],
    },
    {
      key: 9,
      name: '诊断-微信窗口可达性',
      matchTime: 20000,
      actionMaximum: 3,
      actionCd: 3000,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text*="美团单车"]',
          action: 'clickCenter',
        },
      ],
    },
  ],
}
