// GKD 规则 6 · 微信小程序里的广告（开屏「跳过」+ 浮层关闭 X + 广告角标菜单）
// 实测环境：Xiaomi 17 / HyperOS 4.0.6 / GKD 1.13.2 / 2026-11-18
// 窗口：com.tencent.mm / .plugin.appbrand.ui.AppBrandUI00（小程序「美团骑行」）
//
//   开屏广告 ： 「广告 ∨」[78,191][169,256]，「跳过」[273,191][373,256]，右侧「N 秒」倒计时
//   首页浮层 ： 关闭 X = 图标字体 TextView \ue003 [1062,390][1124,455]（容器 [1069,392][1189,489]）
//               同一页右上角「我的」笑脸也是 \ue003 [1056,357][1118,422] → 靠 top>=385 排除
//
// ⚠️ 三条实测教训，缺一条就不动作：
//   1) 不要开 fastQuery —— 小程序节点变化不一定推给无障碍，快速查询会漏；
//   2) actionMaximum 用 0 —— 小程序复用同一个 AppBrandUI00，写 1 会导致之后再进不再触发；
//   3) action 必须是 'clickCenter' —— 「跳过」是 clickable=false 的 TextView，
//      默认 clickNode 会沿父链找可点击祖先，找不到就整条放弃（表现为完全不动）。
//
// 用法：GKD → 订阅 → 本地订阅 → 应用规则 → ＋ → 粘贴下面整段对象

{
  id: 'com.tencent.mm',
  name: '微信',
  groups: [
    {
      key: 0,
      name: '小程序开屏-跳过',
      matchTime: 20000,
      actionMaximum: 0,
      actionCd: 300,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text*="跳过"]',
          action: 'clickCenter',
        },
      ],
    },
    {
      key: 1,
      name: '小程序浮层广告-关闭',
      matchTime: 30000,
      actionMaximum: 0,
      actionCd: 500,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text="\ue003"][left>=1050][left<=1085][top>=385][top<=405][bottom<480]',
          action: 'clickCenter',
        },
      ],
    },
    {
      key: 2,
      name: '广告角标-点开',
      actionCd: 1500,
      matchTime: 20000,
      actionMaximum: 0,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text="广告"][width<200][left<300][visibleToUser=true]',
          anyMatches: [
            '[text*="全部行程"]',
            '[text="去骑车"]',
            '[text*="骑行"]',
          ],
        },
      ],
    },
    {
      key: 3,
      name: '广告菜单-关闭广告',
      matchTime: 8000,
      actionMaximum: 0,
      resetMatch: 'activity',
      rules: [
        {
          key: 0,
          matches: '[text*="关闭广告"]',
        },
      ],
    },
    {
      key: 9,
      name: '诊断-微信窗口可达性',
      matchTime: 0,
      actionMaximum: 0,
      actionCd: 5000,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text="广告由微信提供"]',
        },
      ],
    },
  ],
}
