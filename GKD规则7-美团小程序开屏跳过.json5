// GKD 规则 7 · 美团（App 与 App 内小程序容器）的开屏「跳过」
// 实测环境：Xiaomi 17 / HyperOS 4.0.6 / GKD 1.13.2 / 2026-11-18
//
//   ① 美团 App 冷启动未见开屏广告，这条属备用。
//   ② App 内小程序容器的营销弹窗画在自绘层（节点树里 0 个 ImageView、无「关闭」文本），
//      节点类规则关不掉，这里只保留开屏「跳过」。
//
// 用法：GKD → 订阅 → 本地订阅 → 应用规则 → ＋ → 粘贴下面整段对象

{
  id: 'com.sankuai.meituan',
  name: '美团',
  groups: [
    {
      key: 0,
      name: '小程序开屏-跳过',
      matchTime: 20000,
      actionMaximum: 1,
      actionCd: 300,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[text*="跳过"]',
          action: 'clickCenter',
        },
      ],
    },
  ],
}
